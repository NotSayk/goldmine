{
  "name": "pepite-rush",
  "version": "0.1.0",
  "private": true,
  "description": "Jeu de cartes « stop ou encore » jouable en ligne à plusieurs (2 à 6 joueurs).",
  "type": "module",
  "workspaces": [
    "packages/engine",
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w @pepite/server\" \"npm run dev -w @pepite/client\"",
    "build": "npm run build -w @pepite/client && npm run build -w @pepite/server",
    "start": "node packages/server/dist/index.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "simulate": "tsx packages/engine/scripts/simulate.ts",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^4.1.12"
  }
}
