# Copier en .env (chmod 600) puis remplir. Ne jamais commiter .env.
# Authentification Claude : un seul des deux (jeton d'abonnement via `claude setup-token`, ou clé API).
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Dépôt et jeton GitHub « fine-grained » limité à CE dépôt : Contents = lecture/écriture.
GH_REPO=NotSayk/speedrunners
GH_TOKEN=
AGENT_MAX_TURNS=80
# Envoi du rapport (côté serveur, jamais donné à l'agent) : un compte SMTP, par exemple celui d'OVH.
SMTP_URL=smtps://ssl0.ovh.net:465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
